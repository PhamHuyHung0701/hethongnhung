# .clangd — clangd configuration for STM32F103 cross-compilation
# Tells clangd to use the compile_commands.json generated by CMake with
# arm-none-eabi-gcc so that all HAL / CMSIS symbols resolve correctly.

CompileFlags:
  # Point to the build directory that contains compile_commands.json
  CompilationDatabase: cmake-build-debug-system

  # Force the correct target triple so clangd uses ARM semantics
  Add:
    - --target=arm-none-eabi
    - -mcpu=cortex-m3
    - -mthumb
    - -DSTM32F103xB
    - -DUSE_HAL_DRIVER
    - -DDEBUG
    # stdint / stddef from the ARM toolchain included via query-driver;
    # until that is set up, prevent clangd complaining about missing builtins
    - -D__CLANGD__

  # Strip flags clangd's own front-end does not understand
  Remove:
    - -mthumb-interwork
    - -fmessage-length=*

Diagnostics:
  # Suppress noisy style-only warnings that don't affect correctness
  Suppress:
    - readability-*
    - cppcoreguidelines-*
    - cert-dcl51-cpp
    - hicpp-*
  ClangTidy:
    Remove:
      - readability-*
      - cppcoreguidelines-*
      - hicpp-*
      - bugprone-easily-swappable-parameters

